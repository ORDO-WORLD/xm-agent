POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-database-password
POSTGRES_DB=postgres
XM_COOKIE_SECURE=0

# Retain integration PDFs for workflow download/retry; both API and worker share /data.
XM_INTEGRATION_EXPORT_DAYS=7

# Optional: lets the platform administrator run this deploy script from the dashboard (pm2 servers only).
# XM_DEPLOY_SCRIPT=/var/www/html/xm-agent/deploy.sh

# --- Sambungan AutoAudit (opsional). Tanpa BASE_URL dan API_KEY fitur ini mati. ---
# Alamat aplikasi utama AutoAudit, mis. https://app.autoaudit.id
AUTOAUDIT_BASE_URL=
# Bearer key integrasi. Hanya dipakai backend; jangan dimasukkan ke variabel frontend.
AUTOAUDIT_API_KEY=
# Token acak panjang di link webhook: https://<alamat Property>/api/hooks/autoaudit/<token>
AUTOAUDIT_WEBHOOK_TOKEN=
# Jeda cek berkala tiap sales tersambung (detik).
AUTOAUDIT_CHECK_SECONDS=600
# Jumlah percobaan unduh dan jeda antar percobaan (detik).
AUTOAUDIT_RETRY_COUNT=10
AUTOAUDIT_RETRY_SECONDS=15
# Panjang satu potongan unduhan (hari).
AUTOAUDIT_CHUNK_DAYS=31

# --- Login hanya lewat AutoAudit. Butuh AUTOAUDIT_BASE_URL di atas. ---
# Company dan Team Access memakai identitas sendiri; tidak ada login password lokal fallback.
XM_SSO_ENABLED=1
# Alamat AutoAudit yang dibuka browser, bila berbeda dari AUTOAUDIT_BASE_URL (mis. backend memakai alamat internal).
AUTOAUDIT_PUBLIC_URL=
# Canonical browser URL of XM (same callback origin configured in AutoAudit).
XM_PUBLIC_BASE_URL=
# Additional approved AutoAudit browser origins, comma separated; never arbitrary return URLs.
AUTOAUDIT_SSO_ORIGINS=
# Shared with AutoAudit; API/worker only, for authenticated activity delivery.
PROPERTY_SSO_SECRET=

# Log aktivitas: catatan "sekadar melihat" dihapus setelah sekian hari. Catatan lain disimpan selamanya.
ACTIVITY_VIEW_RETENTION_DAYS=90
